# Copy to .env next to the notebook. Never commit .env.

# ---- Required ----------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<resource>/projects/<project>
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AOAI_ENDPOINT=https://<resource>.openai.azure.com
AOAI_GPT_DEPLOYMENT=gpt-4.1-mini
AOAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# ---- Optional: auth (blank = Entra ID / managed identity, recommended) -------
SEARCH_API_KEY=
AOAI_API_KEY=

# ---- Optional: models ----------------------------------------------------------
# Underlying model names, only if they differ from the deployment names
AOAI_GPT_MODEL=
AOAI_EMBEDDING_MODEL=
AOAI_EMBEDDING_DIMENSIONS=3072
# Agent can use a different deployment, e.g. model-router
AGENT_MODEL_DEPLOYMENT=

# ---- Optional: federated Web knowledge source (billed per query) -------------
ENABLE_WEB_KS=false
WEB_KS_ALLOWED_DOMAINS=cpsc.gov

# ---- Optional: Retail Catalog API from Session 6 -----------------------------
# anonymous | connection | managed_identity
RETAIL_API_AUTH=anonymous
RETAIL_OPENAPI_SPEC=../session-06-microsoft_foundry_agents/assets/retail_openapi_anonymous.json
RETAIL_API_CONNECTION_NAME=
RETAIL_API_AUDIENCE=

# ---- Optional: toolbox ---------------------------------------------------------
TOOLBOX_NAME=contoso-support-toolbox
