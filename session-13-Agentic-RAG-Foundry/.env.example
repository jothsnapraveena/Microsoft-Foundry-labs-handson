# Copy to .env and fill in. Never commit .env or put secrets in this file.

# --- Tool service ---
# "demo" trusts the X-Demo-Customer-Id header. LOCAL USE ONLY. Leave unset (or "entra") when deployed.
NORTHSTAR_AUTH_MODE=demo
# The dataset's labels are computed for this date. Unset it to use the real date.
NORTHSTAR_FIXED_DATE=2026-10-03
NORTHSTAR_DB_PATH=data/app.sqlite
NORTHSTAR_PROPOSAL_TTL_SECONDS=900

# --- Microsoft Entra token validation (NORTHSTAR_AUTH_MODE=entra) ---
ENTRA_TENANT_ID=<tenant-guid>
ENTRA_AUDIENCE=api://<your-api-app-id>
ENTRA_CONFIRM_SCOPE=Returns.Confirm
ENTRA_CUSTOMER_CLAIM=oid

# --- Azure resources (stage 3 onward; not used yet) ---
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AGENT_MODEL=gpt-5
# Model the knowledge base uses to plan queries (low and medium reasoning effort). Defaults to AGENT_MODEL.
KNOWLEDGE_BASE_MODEL_DEPLOYMENT=gpt-5-mini
AZURE_SEARCH_INDEX=northstar-policies
AZURE_SEARCH_KNOWLEDGE_SOURCE=northstar-policies-ks
AZURE_SEARCH_KNOWLEDGE_BASE=northstar-policies-kb
NORTHSTAR_POLICY_AGENT=northstar-policy-agent

# --- Tracing ---
# azure: export spans to the Application Insights resource connected to the Foundry project.
# console: print spans locally. Leave unset for no export.
NORTHSTAR_TRACING=azure
# Set to 1 to also record question and answer text in spans. Off by default: traces are readable by
# anyone with access to the Application Insights resource.
NORTHSTAR_TRACE_CONTENT=0
# Optional, for an ESTIMATED cost attribute. US dollars per million tokens, from your own price sheet.
# NORTHSTAR_PRICE_INPUT_PER_1M=
# NORTHSTAR_PRICE_OUTPUT_PER_1M=
# Judge model for evaluations. Prefer a different model family from the agent if you have one.
# EVALUATION_MODEL_DEPLOYMENT=gpt-5-mini
# Azure resource ID of the Foundry project, for the portal agent's connection:
# /subscriptions/<id>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<resource>/projects/<project>
PROJECT_RESOURCE_ID=
NORTHSTAR_PORTAL_AGENT=northstar-portal-agent
